{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A synchronization room.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "isPlaying": { "type": "boolean" },
        "audioSource": { "type": "string" },
        "startTime": { "type": "number" },
        "pauseOffset": { "type": "number" },
        "hostId": { "type": "string" }
      },
      "required": ["code", "isPlaying", "audioSource", "startTime", "pauseOffset", "hostId"]
    }
  },
  "firestore": {
    "/rooms/{code}": {
      "schema": "Room",
      "description": "Synchronization room state."
    }
  }
}
